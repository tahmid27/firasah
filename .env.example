# No GOOGLE_APPLICATION_CREDENTIALS here — BigQuery auth uses Application
# Default Credentials instead of a downloadable service account key (the
# GCP org this project's billing account sits under disables service
# account key creation by default). Run once per machine:
#   gcloud auth application-default login
# User ADC has no project baked in (unlike a service account key), so it
# has to be told explicitly:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JUSTGIVING_APP_ID=your-justgiving-app-id
# One or more JustGiving event IDs, comma-separated; every fundraising page
# under each event is pulled
JUSTGIVING_EVENT_IDS=4100201,4100202

TIKTOK_CLIENT_KEY=your-tiktok-sandbox-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-sandbox-client-secret
TIKTOK_ACCESS_TOKEN=set-by-scripts/tiktok_oauth_exchange.py
TIKTOK_REFRESH_TOKEN=set-by-scripts/tiktok_oauth_exchange.py
TIKTOK_REDIRECT_URI=https://your-ngrok-static-domain/auth/tiktok/callback

MAILCHIMP_API_KEY=your-mailchimp-api-key-endingin-yourdc

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_ACCESS_TOKEN=set-by-scripts/instagram_token_exchange.py
INSTAGRAM_USER_ID=your-instagram-business-account-id

PREFECT_SERVER_ANALYTICS_ENABLED=false
