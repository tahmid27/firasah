# Firasah demo-data refresh job image (Cloud Run Job). Build context is the repo root.
# Regenerates the synthetic charities, loads them into BigQuery and rebuilds dbt.

# Stage 1: install dependencies into a virtualenv. The dev group is included on
# purpose: the generator uses Faker, which is a dev dependency.
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --locked --no-install-project

# Stage 2: runtime image with the venv and only the code the job imports
FROM python:3.12-slim
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY core ./core
COPY ingestion ./ingestion
COPY synthetic ./synthetic
COPY dbt ./dbt
COPY ci/synthetic ./ci/synthetic
RUN mkdir -p data && chown -R app:app data

# dbt runs as `dbt` (no uv in this image) and writes only under /tmp. The
# generator imports the real connectors, which read their API keys on import;
# synthetic data makes no real API calls, so these are placeholders.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    HOME=/home/app \
    FIRASAH_DBT=dbt \
    DBT_PROFILES_DIR=/app/ci/synthetic \
    DBT_TARGET_PATH=/tmp/dbt-target \
    DBT_LOG_PATH=/tmp/dbt-logs \
    GOOGLE_CLOUD_PROJECT=firasah-dev-511916 \
    PREFECT_SERVER_ANALYTICS_ENABLED=false \
    JUSTGIVING_APP_ID=placeholder \
    MAILCHIMP_API_KEY=placeholder-us1 \
    INSTAGRAM_ACCESS_TOKEN=placeholder \
    TIKTOK_CLIENT_KEY=placeholder \
    TIKTOK_CLIENT_SECRET=placeholder \
    TIKTOK_REFRESH_TOKEN=placeholder
USER app

# The job's identity (a service account) supplies Google credentials
CMD ["python", "-m", "synthetic.load", "--skip-supabase", "--keep-marts"]
